# Firebase — cole o conteúdo do serviceAccountKey.json numa única linha
# Gere em: console.firebase.google.com → Configurações → Contas de serviço → Gerar nova chave privada
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Flask
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
FLASK_ENV=production
